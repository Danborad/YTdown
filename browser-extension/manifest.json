{
  "manifest_version": 3,
  "name": "YT下载器 Cookie Sync",
  "version": "1.0.0",
  "description": "将浏览器 Cookie 自动同步到 YT下载器。",
  "permissions": [
    "cookies",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://*.bilibili.com/*",
    "https://*.vimeo.com/*",
    "https://*.tiktok.com/*",
    "https://*.twitter.com/*",
    "https://*.x.com/*",
    "https://*.instagram.com/*",
    "https://*.behance.net/*",
    "https://*.adobe.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "YT下载器 Cookie Sync",
    "default_popup": "popup.html"
  }
}
